# Copy to .env and adjust. Never commit .env.
POSTGRES_USER=neurostream
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=neurostream
POSTGRES_PORT=5432
REDIS_PORT=6379

# Used by services running on the host (inside Compose they use service names)
DATABASE_URL=postgresql+psycopg://neurostream:change-me-locally@localhost:5432/neurostream
REDIS_URL=redis://localhost:6379/0

# Where the EEGMMIDB EDF files are stored (gitignored)
EEG_DATA_DIR=./data
